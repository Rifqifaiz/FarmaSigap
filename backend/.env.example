# Salin menjadi .env lalu sesuaikan.
APP_NAME="FarmaSigap API"

# Database (default SQLite di backend/farmasigap.db)
DATABASE_URL=sqlite:///./farmasigap.db
# DATABASE_URL=postgresql+psycopg://farmasigap:farmasigap@localhost:5432/farmasigap

# Seed data demo
SEED_ON_STARTUP=true
RESET_DB_ON_STARTUP=false
# Tanggal acuan data demo (kosongkan = hari ini), format YYYY-MM-DD
# DEMO_REFERENCE_DATE=2026-10-20

# Model ML
TRAIN_MODEL_ON_STARTUP=true
PREFER_LIGHTGBM=true

# Parameter bisnis
ACTIVE_DISASTER=karhutla
ACTIVE_DISTRICT="Kubu Raya"
YELLOW_BUFFER_DAYS=7
PLANNING_HORIZON_DAYS=14
DONOR_RESERVE_DAYS=14

# CORS (pisahkan dengan koma). "null" = halaman dibuka dari file://
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173,http://localhost:8000,null
